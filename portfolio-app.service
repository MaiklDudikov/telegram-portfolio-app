[Unit]
Description=Telegram Portfolio Mini App
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/telegram-portfolio-app/backend
EnvironmentFile=/opt/telegram-portfolio-app/backend/.env
ExecStart=/opt/telegram-portfolio-app/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
